{# 评论：沿用原站 LeanCloud 应用，URL 未变，历史评论应能继续显示 #}
<script src="https://cdn1.lncld.net/static/js/3.0.4/av-min.js"></script>
<script src="https://unpkg.com/valine/dist/Valine.min.js"></script>
<script>
  (function () {
    var mount = document.querySelector('#comments');
    if (!mount || typeof Valine === 'undefined') return;
    var allowed = ['nick', 'mail', 'link'];
    var guest = 'nick,mail,link'
      .split(',')
      .filter(function (item) {
        return allowed.indexOf(item) > -1;
      });
    new Valine({
      el: '#comments',
      verify: false,
      notify: false,
      appId: 'pDMnuCn44ZQITVEtQAfiiXr5-gzGzoHsz',
      appKey: 'y43DvreFS6iyfhy7ScRCF8Cy',
      placeholder: 'Just go go',
      avatar: 'mm',
      guest_info: guest,
      pageSize: 10
    });
  })();
</script>

{# 音乐播放器：原站网易云歌单 + APlayer + MetingJS，参数逐项沿用 #}
<script src="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/meting@2.0.1/dist/Meting.min.js"></script>
<meting-js
  server="netease"
  id="7091778006"
  type="playlist"
  mini="true"
  fixed="true"
  list-folded="true"
  autoplay="true"
  volume="0.5"
  theme="#FADFA3"
  order="random"
  loop="all"
  preload="auto"
  mutex="true">
</meting-js>
